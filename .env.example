# ─── REQUIRED ───────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/autoapply_pro?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_minimum_32_characters_here!!
REFRESH_TOKEN_SECRET=your_refresh_secret_minimum_32_chars_here

# ─── AI (FREE - get at console.groq.com) ────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── ENCRYPTION (keep these exactly 32 and 16 chars) ─────
ENCRYPTION_KEY=12345678901234567890123456789012
ENCRYPTION_IV=1234567890123456

# ─── FRONTEND URL ────────────────────────────────────────
CLIENT_URL=https://your-app.vercel.app

# ─── GOOGLE OAUTH (get at console.cloud.google.com → APIs & Services → Credentials) ─
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── GITHUB OAUTH (get at github.com/settings/developers → OAuth Apps) ─
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ─── OPTIONAL: More job sources (free at developer.adzuna.com) ─
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_api_key
